# Configuration du serveur
PORT=5001
NODE_ENV=development

# Clé secrète JWT pour la signature des sessions
JWT_SECRET=TECHSTORE_SUPER_SECRET_KEY_2026_XYZ

# ─────────────────────────────────────────────────────────────
# 🍃 CONNEXION MONGODB ATLAS (Cloud) OU LOCAL
# ─────────────────────────────────────────────────────────────
# 1. Pour MongoDB Atlas (Cloud) :
# Décommentez la ligne ci-dessous et insérez vos identifiants obtenus sur cloud.mongodb.com :
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/techstore_db?retryWrites=true&w=majority

# 2. Pour MongoDB en local (actif par défaut) :
MONGO_URI=mongodb://127.0.0.1:27017/techstore_db
